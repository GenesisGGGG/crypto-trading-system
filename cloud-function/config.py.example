# Copy this file to config.py and fill in your own credentials.
# config.py is gitignored — never commit real keys.

# Coinbase Developer Platform API key (CDP format: organizations/<org>/apiKeys/<key>)
API_KEY = 'organizations/<YOUR-ORG-ID>/apiKeys/<YOUR-KEY-ID>'

# EC private key from the Coinbase API key download (.pem contents, \n escaped)
API_SECRET = '-----BEGIN EC PRIVATE KEY-----\n<YOUR_EC_PRIVATE_KEY>\n-----END EC PRIVATE KEY-----\n'

# Secret passphrase your TradingView webhook alerts must include
PASSPHRASE_TRADINGVIEW = 'your_tradingview_webhook_passphrase'
