//@version=5
strategy("Extreme Candle Reversal Strategy 1D", overlay=true)

// Percentage thresholds for entry & exit
dropThreshold = 0.14  // 15% drop
riseThreshold = 0.10  // 10% rise

// Calculate price percentage changes
priceDrop = (low / close[1]) - 1  // % change when price drops
priceRise = (high / close[1]) - 1 // % change when price rises

// Entry Condition: Price drops 15% or more
longCondition = priceDrop <= -dropThreshold

// Exit Condition: Price rises 12% or more
exitCondition = priceRise >= riseThreshold

// Execute Long Entry
if longCondition
    strategy.entry("Long", strategy.long)

// Close position if exit condition is met
if exitCondition
    strategy.close("Long", comment="Exit: Price up 10%")
