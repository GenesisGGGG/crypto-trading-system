//@version=5
indicator("Stoploss")
// Input for RSI
rsiPeriod = input.int(13, title="RSI Period")
rsiUnderbought = input.int(45, title="RSI Overbought Level")
rsiLevel = ta.rsi(close, rsiPeriod)

// Input for MACD
macdShortTerm = input.int(5, title="MACD Short Term Period")
macdLongTerm = input.int(13, title="MACD Long Term Period")
macdSignal = input.int(5, title="MACD Signal Period")
[macdLine, signalLine, _] = ta.macd(close, macdShortTerm, macdLongTerm, macdSignal)

// Variables to track the buy condition
var bool rsiUnder30 = false
var bool macdCrossedUp = false
var float buyPrice = na

// Check if RSI is below 30
if rsiLevel < rsiUnderbought
    rsiUnder30 := true


// Check if MACD crosses up from below the signal line
if ta.crossover(macdLine, signalLine) and rsiUnder30
    macdCrossedUp := true
    buyPrice := close

// Sell logic: if the price drops 1% from the buy price
sellSignal = not na(buyPrice) and close <= buyPrice * 0.99 or not na(buyPrice) and close >= buyPrice * 1.0125

// Plot the sell signal (optional)
plotshape(sellSignal, title="Stoploss", location=location.belowbar, color=color.red, style=shape.labeldown, text="stoploss")
// Alert condition for sell signal when price drops 1%
alertcondition(sellSignal, title="Sell Signal", message="Price dropped 1% from buy price. Sell Signal!")

if sellSignal
    buyPrice := na

// Once a buy is triggered, reset the MACD condition until RSI goes below 30 again
macdCrossedUp := false // Reset MACD condition after a buy signal
rsiUnder30 := false // Reset buySignal to prevent continuous alerts
